# --- OPNsense API (System > Zugang > Benutzer > API-Schlüssel) ---
OPNSENSE_URL=https://192.168.10.1
OPNSENSE_KEY=dein_api_key
OPNSENSE_SECRET=dein_api_secret
OPNSENSE_VERIFY_SSL=false

# --- Netze: 192.168.<VLAN>.0/24 ---
SUBNET_PREFIX=192.168
VLANS=10,20,30,40,50,60,70,80,90
# optionale Anzeigenamen
VLAN_NAMES=10:Management,20:Clients,30:Server,40:IoT,50:Gäste,60:Kameras,70:Smarthome,80:Lab,90:DMZ

# --- Scan / Online-Erkennung ---
SCAN_INTERVAL=60
# ping_or_arp (empfohlen) | ping | arp
ONLINE_MODE=ping_or_arp
# so viele fehlgeschlagene Prüfungen, bis ein Gerät als offline gilt
OFFLINE_AFTER_CHECKS=3
INCLUDE_FIREWALL=false

# --- UniFi (optional, leer lassen = aus) ---
UNIFI_URL=https://192.168.10.2
UNIFI_USER=netwatch
UNIFI_PASSWORD=
UNIFI_SITE=default
UNIFI_IS_UNIFI_OS=true
UNIFI_VERIFY_SSL=false
UNIFI_USE_NAMES=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789
# Nachricht bei jedem neuen Gerät
NOTIFY_NEW_DEVICES=true
# neue Geräte automatisch für online/offline-Meldungen beobachten
WATCH_NEW_DEVICES=false
# private MAC + gleicher Hostname = gleiches Gerät (WLAN-Wechsel)
MERGE_RANDOM_MAC=true
# Meldung auch für neue Geräte mit privater MAC
NOTIFY_RANDOM_MAC=true
# Bot-Befehle /check NAME, /online, /offline, /status, /scan
TELEGRAM_COMMANDS=true

# --- Web-UI ---
WEB_PORT=8080
WEB_USER=admin
# leer lassen = kein Passwort
WEB_PASSWORD=
